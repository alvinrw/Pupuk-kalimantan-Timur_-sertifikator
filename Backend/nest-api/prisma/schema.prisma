generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MasterItem {
  id                    String                 @id @default(uuid())
  code                  String?
  title                 String
  categoryKey           String
  unitLocation          String?
  status                String                 @default("Aktif")
  luasM2                String?
  luasHa                String?
  peruntukan            String?
  issueDate             String?
  expiryDate            String?
  keterangan            String?
  documentStatus        String                 @default("PENDING_DOC")
  exemptionNote         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  isManuallyEdited      Boolean                @default(false)
  lastEditSource        String?
  validationErrors      String?
  validationStatus      String                 @default("NEW")
  imageUrl              String?
  position              Int                    @default(0)
  certificates          Certificate[]
  documentHistories     DocumentHistory[]
  notificationSetting   NotificationSetting?
  permits               Permit[]
  reminderNotifications ReminderNotification[]

  @@map("master_items")
}

model Certificate {
  id                    String                 @id @default(uuid())
  itemId                String
  jenisSertifikat       String
  noSertifikat          String?
  instansi              String?
  terbit                String?
  expired               String?
  status                String                 @default("Aktif")
  fileUrl               String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  namaSertifikat        String?
  uploadedBy            String?
  keterangan            String?
  item                  MasterItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  monitoringLogs        MonitoringLog[]
  notificationSetting   NotificationSetting?
  reminderNotifications ReminderNotification[]

  @@map("certificates")
}

model Permit {
  id         String     @id @default(uuid())
  itemId     String
  jenisIzin  String
  noIzin     String?
  instansi   String?
  terbit     String?
  expired    String?
  status     String     @default("Aktif")
  keterangan String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  item       MasterItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("permits")
}

model DocumentHistory {
  id          String     @id @default(uuid())
  itemId      String
  action      String
  description String
  changedBy   String?
  createdAt   DateTime   @default(now())
  item        MasterItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("document_history")
}

model MonitoringLog {
  id            String       @id @default(uuid())
  certificateId String?
  action        String?
  logType       String?
  message       String?
  status        String?
  detail        String?
  isResolved    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@map("monitoring_logs")
}

model NotificationSetting {
  id            String       @id @default(uuid())
  itemId        String?      @unique
  certificateId String?      @unique
  isEnabled     Boolean      @default(true)
  triggerType   String       @default("DAYS")
  triggerDays   Int          @default(30)
  triggerDate   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  item          MasterItem?  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model ReminderNotification {
  id            String       @id @default(uuid())
  itemId        String?
  certificateId String?
  reminderType  String?
  message       String?
  isResolved    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  item          MasterItem?  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("reminder_notifications")
}

model IuranKeanggotaan {
  id               String   @id @default(uuid())
  nomer            String?
  kompartemen      String?
  unitKerja        String?
  asosiasi         String?
  periode          String?
  nominal          Float?
  status           String?  @default("Belum Lunas")
  statusPembayaran String?  @default("Belum Lunas")
  nama             String?
  npk              String?
  keterangan       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("iuran_keanggotaan")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id           String        @id @default(uuid())
  nama         String
  npk          String        @unique
  username     String        @unique
  password     String
  roleId       Int           @map("role_id")
  lastActive   DateTime?     @map("last_active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activityLogs ActivityLog[]
  role         Role          @relation(fields: [roleId], references: [id])

  @@map("users")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  action      String
  targetTable String   @map("target_table")
  targetId    String?  @map("target_id")
  details     String?
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model ColumnConfig {
  id          String   @id @default(uuid())
  categoryKey String
  fieldKey    String
  label       String
  type        String   @default("text") // "text", "nominal", "date"
  position    Int      @default(0)
  isVisible   Boolean  @default(true)
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryKey, fieldKey])
  @@map("column_configs")
}

